+    // Tray activation does not reliably focus existing niri windows.
+    function activateOrFocusTrayItem(trayItem) {
+        const helper = Quickshell.env("DMS_TRAY_FOCUS_HELPER");
+        if (!CompositorService.isNiri || !helper) {
+            trayItem.activate();
+            return;
+        }
+        Proc.runCommand("tray-focus-" + trayItem.id,
+            [helper, trayItem.id], (output, exitCode) => {
+                if (exitCode !== 0)
+                    trayItem.activate();
+            }, 0, 10000);
     }
 
