{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: Build active file (g++)",
      "type": "process",
      "args": [
        "-std=c++17",
        "-fdiagnostics-color=always",
        "-g",
        "-O0",
        "-Wall",
        "-Wextra",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "C++: Build optimized active file (g++)",
      "type": "process",
      "args": [
        "-std=c++17",
        "-pipe",
        "-O2",
        "-g",
        "-fdiagnostics-color=always",
        "-Wall",
        "-Wextra",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.run"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    }
  ]
}
