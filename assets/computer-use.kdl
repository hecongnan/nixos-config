// Highlight windows driven by the patched niri computer-use backend.
window-rule {
    match is-agent-driven=true
    border {
        on
        width 2
        active-gradient from="#818cf8" to="#c084fc" angle=135
        inactive-gradient from="#818cf8" to="#c084fc" angle=135
    }
    shadow {
        on
        softness 40
        spread 3
        offset x=0 y=0
        color "#a78bfa70"
    }
}
